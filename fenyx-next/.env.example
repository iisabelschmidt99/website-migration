# Kopiere diese Datei nach `.env.local` und trage die echten Werte ein.
# `.env.local` ist gitignored und wird nicht committed.
#
# Schlüssel finden: Supabase Dashboard → Project Settings → API
# Projekt-URL (aus next.config.mjs): https://aadugmrnlvsmdxisaady.supabase.co

# ── Next.js / Supabase (öffentlich, im Client-Bundle) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://aadugmrnlvsmdxisaady.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (NIEMALS NEXT_PUBLIC setzen!) ───────────────────────────────
# Wird für /api/admin/users (Nutzer anlegen / einladen) benötigt.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Zugangsdaten per E-Mail bei manuellem Nutzer-Anlegen (/admin/benutzer)
# RESEND_API_KEY=
# RESEND_FROM=Fenyx Backend <noreply@fenyx-office.com>

# ── Supabase CLI + Management API (nur lokal, nicht committen) ─────────────
# Personal Access Token: https://supabase.com/dashboard/account/tokens
# Ermöglicht: `supabase link`, `supabase db push`, SQL via api.supabase.com/v1/.../database/query
# SUPABASE_ACCESS_TOKEN=
