# Kopiere nach `.env.local` und trage echte Werte ein.
# `.env.local` ist gitignored.

# ── Supabase (öffentlich, im Client-Bundle) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://aadugmrnlvsmdxisaady.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only) ──────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_JWT_SECRET=
SUPABASE_ANALYTICS_KEY=
# Legacy fallback, nur wenn das Projekt noch externe HS256-JWTs akzeptiert:
SUPABASE_ANALYTICS_JWT=

# ── Analytics System A ────────────────────────────────────────────────────────
ANALYTICS_SALT_SECRET=
NEXT_PUBLIC_ANALYTICS_INGRESS_URL=
# ANALYTICS_ALLOWED_ORIGINS=https://www.fenyx-office.com,https://fenyx-office.com,http://localhost:3000

# ── Analytics System B (GTM) ─────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_BASE_URL=

# ── Google ────────────────────────────────────────────────────────────────────
GOOGLE_CRUX_API_KEY=
GTM_SERVICE_ACCOUNT_JSON=

# ── Cloudflare (NUR Fenyx-Konto — siehe cloudflare/README.md) ───────────────
# Account-ID aus Fenyx-Dashboard; niemals MCP-/Privat-Account verwenden.
CLOUDFLARE_ACCOUNT_ID=
# Workers Scripts Edit — nur für deploy / cf-whoami
CLOUDFLARE_WORKERS_DEPLOY_TOKEN=
# Zone Analytics / Dashboard (später)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM=Fenyx Backend <noreply@fenyx-office.com>
# DATABASE_URL=
